  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Movement: The game is meant to reflect a feeling of suddenly not being
    able to move about in a way that you used to. Because of this the controls are
    a bit. odd.

    You will be moving about using a wheelchair. left mouse click
    allows movement for left wheel, right click allows movement for right wheel.
    Youe then use the scroll wheel to push the wheels, so if you want to move straight
    forward, hold both keys down and scroll forward'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
